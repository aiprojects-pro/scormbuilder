# PLANTILLA (no aplicar tal cual). Forma que tendrá el SealedSecret generado
# por `kubeseal` en deploy/gitops/seal-secret.sh.
#
# El valor real `encryptedData` será una cadena cifrada de cientos de bytes
# por cada clave. Solo el controller en kube-system puede descifrarlo.

apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: scormbuilder-secrets
  namespace: scormbuilder
spec:
  encryptedData:
    ANTHROPIC_API_KEY: AgBy3i4OJSWK+PiTySYZZA9rO43cGDEQAx... (recortado)
    SMTP_PASSWORD: AgARw2VyhcCD7iiOwc8WjOcc...
  template:
    metadata:
      name: scormbuilder-secrets
      namespace: scormbuilder
      labels:
        app.kubernetes.io/name: scormbuilder
    type: Opaque
